# Configura una base MySQL local antes de ejecutar migraciones.
DATABASE_URL="mysql://driver_connect:CHANGE_ME@127.0.0.1:3306/driver_connect"

# Sesiones administrativas: mínimo 32 caracteres. Cambiarlo cierra todas las sesiones.
# Genera un valor local: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Abre la aplicación exactamente con este origen. En AWS: https://tu-dominio.
# HTTP sólo se admite en localhost; HTTPS activa la cookie Secure.
APP_ORIGIN="http://127.0.0.1:3000"

# Docker Compose: genera contraseñas distintas con openssl rand -hex 32.
# Usa valores hexadecimales para evitar caracteres reservados en DATABASE_URL.
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""

# Calendario del teléfono: configurar los proveedores que vayas a habilitar.
# Secreto independiente de 32 bytes hexadecimales; conservarlo junto al respaldo de la DB.
CALENDAR_TOKEN_KEY=""
CALENDAR_GOOGLE_CLIENT_ID=""
CALENDAR_GOOGLE_CLIENT_SECRET=""
CALENDAR_MICROSOFT_CLIENT_ID=""
CALENDAR_MICROSOFT_CLIENT_SECRET=""
# Fotos: Docker usa el volumen driver_uploads. En local, ./data/uploads.
UPLOAD_DIR=""
