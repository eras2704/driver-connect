# Configura una base MySQL local antes de ejecutar migraciones.
DATABASE_URL="mysql://driver_connect:CHANGE_ME@127.0.0.1:3306/driver_connect"

# Reservado para la futura implementación de sesiones; no habilita autenticación.
# Genera un valor local: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Docker Compose: genera contraseñas distintas con openssl rand -hex 32.
# Usa valores hexadecimales para evitar caracteres reservados en DATABASE_URL.
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
