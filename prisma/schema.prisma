generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Los perfiles nuevos permanecen en borrador hasta su publicación administrativa.
model Driver {
  id          String      @id @default(cuid())
  slug        String      @unique @db.VarChar(191)
  name        String      @db.VarChar(191)
  phone       String?     @db.VarChar(32)
  whatsapp    String?     @db.VarChar(32)
  email       String?     @db.VarChar(191)
  location    String?     @db.VarChar(191)
  experience  Int         @default(0)
  languages   Json?
  description String?     @db.Text
  photoUrl    String?     @db.Text
  verified    Boolean     @default(false)
  active      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vehicles    Vehicle[]
  services    Service[]
  user        DriverUser?
  bookings    Booking[]
}

model Vehicle {
  id          String   @id @default(cuid())
  driverId    String
  brand       String   @db.VarChar(100)
  model       String   @db.VarChar(100)
  year        Int
  color       String?  @db.VarChar(64)
  plate       String?  @db.VarChar(32)
  passengers  Int      @default(4)
  description String?  @db.Text
  photoUrl    String?  @db.Text
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(191)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  drivers     Driver[]
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(191)
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  tokenHash String    @id @db.VarChar(64)
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key       String   @id @db.VarChar(128)
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model DriverUser {
  id           String   @id @default(cuid())
  driverId     String   @unique
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  active       Boolean  @default(false)
  mustChangePassword Boolean @default(true)
  calendarVersion Int @default(0)
  calendarEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  sessions     DriverSession[]
}

model DriverSession {
  tokenHash String @id @db.VarChar(64)
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user DriverUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model Booking {
  id String @id @default(cuid())
  driverId String
  serviceName String @db.VarChar(191)
  customerName String @db.VarChar(100)
  phone String @db.VarChar(32)
  email String? @db.VarChar(191)
  pickup String @db.VarChar(250)
  destination String @db.VarChar(250)
  notes String? @db.Text
  passengers Int @default(1)
  startsAt DateTime
  endsAt DateTime
  status BookingStatus @default(PENDING)
  source String @default("REQUEST") @db.VarChar(16)
  version Int @default(0)
  wasConfirmed Boolean @default(false)
  passengerVersion Int @default(0)
  requestHash String? @unique @db.VarChar(64)
  payloadHash String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  @@index([driverId, startsAt])
  @@index([driverId, status, startsAt])
}

model RequestLimit {
  key String @id @db.VarChar(128)
  attempts Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}
