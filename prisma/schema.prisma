generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Los perfiles nuevos permanecen en borrador hasta su publicación administrativa.
model Driver {
  id          String      @id @default(cuid())
  slug        String      @unique @db.VarChar(191)
  name        String      @db.VarChar(191)
  phone       String?     @db.VarChar(32)
  whatsapp    String?     @db.VarChar(32)
  email       String?     @db.VarChar(191)
  location    String?     @db.VarChar(191)
  experience  Int         @default(0)
  languages   Json?
  description String?     @db.Text
  photoUrl    String?     @db.Text
  portraitStorageKey String? @unique @db.VarChar(64)
  verified    Boolean     @default(false)
  active      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vehicles    Vehicle[]
  services    Service[]
  user        DriverUser?
  bookings    Booking[]
  photos      DriverPhoto[]
}

model Vehicle {
  id          String   @id @default(cuid())
  driverId    String
  brand       String   @db.VarChar(100)
  model       String   @db.VarChar(100)
  year        Int
  color       String?  @db.VarChar(64)
  plate       String?  @db.VarChar(32)
  passengers  Int      @default(4)
  description String?  @db.Text
  photoUrl    String?  @db.Text
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(191)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  drivers     Driver[]
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(191)
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  tokenHash String    @id @db.VarChar(64)
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key       String   @id @db.VarChar(128)
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model DriverUser {
  id           String   @id @default(cuid())
  driverId     String   @unique
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  active       Boolean  @default(false)
  mustChangePassword Boolean @default(true)
  calendarVersion Int @default(0)
  calendarEnabled Boolean @default(false)
  accessVersion Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  sessions     DriverSession[]
  calendarConnections CalendarConnection[]
}

model DriverSession {
  tokenHash String @id @db.VarChar(64)
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user DriverUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model Booking {
  id String @id @default(cuid())
  driverId String
  serviceName String @db.VarChar(191)
  customerName String @db.VarChar(100)
  phone String @db.VarChar(32)
  email String? @db.VarChar(191)
  pickup String @db.VarChar(250)
  destination String @db.VarChar(250)
  notes String? @db.Text
  passengers Int @default(1)
  startsAt DateTime
  endsAt DateTime
  status BookingStatus @default(PENDING)
  source String @default("REQUEST") @db.VarChar(16)
  version Int @default(0)
  wasConfirmed Boolean @default(false)
  passengerVersion Int @default(0)
  requestHash String? @unique @db.VarChar(64)
  payloadHash String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  calendarConnections CalendarConnection[]
  calendarEvents CalendarEvent[]
  @@index([driverId, startsAt])
  @@index([driverId, status, startsAt])
}

model RequestLimit {
  key String @id @db.VarChar(128)
  attempts Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

enum CalendarConnectionStatus {
  ACTIVE
  REAUTH
  DISCONNECTED
}

// Una autorización independiente por conductor o por navegador y viaje del pasajero.
model CalendarConnection {
  id String @id @default(cuid())
  ownerKey String @db.VarChar(191)
  ownerVersion Int
  provider CalendarProvider
  accountHash String @db.VarChar(64)
  accountLabel String @db.VarChar(191)
  driverUserId String?
  bookingId String?
  refreshToken String? @db.Text
  status CalendarConnectionStatus @default(ACTIVE)
  credentialsVersion Int @default(0)
  syncVersion Int @default(0)
  nextSyncAt DateTime?
  lastSyncAt DateTime?
  lastError String? @db.VarChar(32)
  attempts Int @default(0)
  leaseToken String? @db.VarChar(64)
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driverUser DriverUser? @relation(fields: [driverUserId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events CalendarEvent[]
  @@unique([ownerKey, provider, accountHash])
  @@index([status, nextSyncAt])
  @@index([driverUserId])
  @@index([bookingId])
}

// Se consume una sola vez; los secretos están cifrados y ligados al navegador.
model CalendarOAuthState {
  stateHash String @id @db.VarChar(64)
  browserHash String @db.VarChar(64)
  ownerKey String @db.VarChar(191)
  ownerVersion Int
  driverUserId String? @db.VarChar(191)
  bookingId String? @db.VarChar(191)
  provider CalendarProvider
  verifier String @db.Text
  expiresAt DateTime
  @@index([expiresAt])
}

// Conserva la identidad del evento para reintentar sin crear copias.
model CalendarEvent {
  id String @id @default(cuid())
  connectionId String
  bookingId String
  operationId String @unique @db.VarChar(64)
  externalId String? @db.VarChar(1024)
  syncedVersion Int @default(-1)
  removed Boolean @default(false)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([connectionId, bookingId])
  @@index([bookingId])
}

enum PhotoCategory {
  TRIP
  VEHICLE
}

model DriverPhoto {
  id String @id @default(cuid())
  driverId String
  storageKey String @unique @db.VarChar(64)
  category PhotoCategory
  caption String @db.VarChar(160)
  position Int @default(0)
  width Int
  height Int
  createdAt DateTime @default(now())
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@index([driverId, position])
}
